{
  "info": {
    "_postman_id": "94bb11ab-3f12-4aa3-8a0a-3ca1637b1d81",
    "name": "Sambandh Setu Backend",
    "description": "Collection for the implemented, documented APIs in backend/API.md. Start the backend with NODE_ENV=development for dev login. Login requests populate the request sender/recipient role variables with Aanya and Rohan by default. For another pair, set requestSenderToken/requestSenderId and requestRecipientToken/requestRecipientId from two dev-login responses. Requests are not run automatically. GET / is implemented but undocumented, and POST /guide/chat is not implemented; neither is included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Profiles",
      "item": [
        {
          "name": "Dev login - Aanya",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"username\":\"aanya\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/dev-login",
            "description": "Development only. No bearer authentication."
          }
        },
        {
          "name": "Dev login - Rohan",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"username\":\"rohan\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/dev-login",
            "description": "Development only. No bearer authentication."
          }
        },
        {
          "name": "Dev login - Karthik",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"username\":\"karthik\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/dev-login",
            "description": "Development only. No bearer authentication."
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/me/profile"
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"bio\":\"I enjoy thoughtful conversations.\",\"interests\":[\"Reading\",\"Walking\"]}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/me/profile",
            "description": "Example editable profile fields from API.md. Set updateMyProfile=true for one manually chosen profile update."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('updateMyProfile') === 'true';",
                  "pm.collectionVariables.set('updateMyProfile', 'false');",
                  "if (!enabled) {",
                  "  console.warn('Skipped profile update: set updateMyProfile=true to opt in to this write once.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get profile by user ID",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/profiles/{{rohanUserId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (!pm.collectionVariables.get('rohanUserId')) {",
                  "  console.warn('Skipped profile lookup: run Dev login - Rohan first.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Connections & Requests",
      "item": [
        {
          "name": "Discover profiles",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/discover?query=&filters="
          }
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/requests?box={{requestBox}}",
            "description": "Recovery/setup: with requestBox=sent, captures an existing pending request ID for the configured sender/recipient pair. This is the safe recovery path after a 409."
          }
        },
        {
          "name": "List requests - invalid box (400)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/requests?box=invalid",
            "description": "Negative validation case; this request does not change data."
          }
        },
        {
          "name": "List active connections",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections?status=active",
            "description": "Run this read-only preflight before Send connection request. Captures an existing active connection ID for the configured sender/recipient pair."
          }
        },
        {
          "name": "Send connection request",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"recipientId\":\"{{requestRecipientId}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/requests",
            "description": "Creates a pending request and notification. Requires createRequest=true (one-use opt-in). Before enabling it, use List requests and List active connections to confirm this pair has neither a pending request nor an active connection. A 409 is an error, not a created request; use the list requests to recover a pending request ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('createRequest') === 'true';",
                  "const configured = ['requestSenderToken', 'requestSenderId', 'requestRecipientToken', 'requestRecipientId'].every(function (key) { return Boolean(pm.collectionVariables.get(key)); });",
                  "const pairExists = Boolean(pm.collectionVariables.get('ssRequestId') || pm.collectionVariables.get('ssActiveConnectionId'));",
                  "pm.collectionVariables.set('createRequest', 'false');",
                  "if (!enabled || !configured || pairExists) {",
                  "  console.warn(pairExists ? 'Skipped request creation: preflight found a pending request or active connection. Use the existing ID instead.' : 'Skipped request creation: configure both users, run List requests and List active connections, then set createRequest=true for one request.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept connection request",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestRecipientToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/requests/{{ssRequestId}}/accept",
            "description": "Accepts a pending request addressed to the configured recipient. Set requestAction=accept to opt in. On success, captures data.connection.id and consumes the pending request ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (pm.collectionVariables.get('requestAction') !== 'accept' || !pm.collectionVariables.get('ssRequestId')) {",
                  "  console.warn('Skipped accept: set requestAction=accept and first capture a pending request ID with List requests or Send connection request.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Decline connection request",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestRecipientToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/requests/{{ssRequestId}}/decline",
            "description": "Alternative to accept: set requestAction=decline and run only this outcome for a pending request addressed to the configured recipient. Do not run after accepting."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (pm.collectionVariables.get('requestAction') !== 'decline' || !pm.collectionVariables.get('ssRequestId')) {",
                  "  console.warn('Skipped decline: set requestAction=decline and first capture a pending request ID.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw connection request",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/requests/{{ssRequestId}}",
            "description": "Alternative to accept or decline: set requestAction=withdraw and run only this outcome for a pending request sent by the configured sender. Do not run after another action."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (pm.collectionVariables.get('requestAction') !== 'withdraw' || !pm.collectionVariables.get('ssRequestId')) {",
                  "  console.warn('Skipped withdraw: set requestAction=withdraw and first capture a pending request ID.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get connection",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (!pm.collectionVariables.get('ssActiveConnectionId')) {",
                  "  console.warn('Skipped Get connection: run List active connections or successfully accept a request first.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get home",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/home"
          }
        },
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Mark notification as read",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (pm.collectionVariables.get('enableNotificationRead') !== 'true' || !pm.collectionVariables.get('notificationId')) {",
                  "  console.warn('Skipped notification update: set enableNotificationRead=true and run List notifications to capture an unread notification.');",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.collectionVariables.set('enableNotificationRead', 'false');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Journey & Reflection",
      "item": [
        {
          "name": "Get connection journey",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/journey"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (!pm.collectionVariables.get('ssActiveConnectionId')) {",
                  "  console.warn('Skipped journey lookup: run List active connections or accept a pending request first.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get stage content",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/stages/{{journeyStage}}",
            "description": "journeyStage must be one of connect, understand, reflect, discuss, agree, family, reflect_again, decision, and the stage must be unlocked."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (!pm.collectionVariables.get('ssActiveConnectionId')) {",
                  "  console.warn('Skipped stage content: no active connection ID.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete active stage",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/stages/{{journeyStage}}/complete",
            "description": "Advances the journey and changes data. Set completeActiveStage=true for one manually chosen active stage only. Reflect requires all 10 answers."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('completeActiveStage') === 'true';",
                  "pm.collectionVariables.set('completeActiveStage', 'false');",
                  "if (!enabled || !pm.collectionVariables.get('ssActiveConnectionId') || !pm.collectionVariables.get('journeyStage') || pm.collectionVariables.get('journeyCompleted') === 'true') {",
                  "  console.warn('Skipped stage completion: set completeActiveStage=true once after confirming the current active stage and any required reflection answers.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get reflection questions",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/reflect/questions",
            "description": "Reflect must be unlocked. The response test stores the first question ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const order = ['connect', 'understand', 'reflect', 'discuss', 'agree', 'family', 'reflect_again', 'decision', 'complete'];",
                  "const stage = pm.collectionVariables.get('journeyStage');",
                  "if (!pm.collectionVariables.get('ssActiveConnectionId') || !stage || order.indexOf(stage) < order.indexOf('reflect')) {",
                  "  console.warn('Skipped reflection questions: an active connection with Reflect unlocked is required.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Save reflection answer",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"value\":\"kindness\",\"sharing\":\"keep_private\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/reflect/answers/{{questionId}}",
            "description": "Example is valid for the seeded first single-select question. Set saveReflectionAnswer=true for a one-use write after Reflect is unlocked."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('saveReflectionAnswer') === 'true';",
                  "pm.collectionVariables.set('saveReflectionAnswer', 'false');",
                  "const order = ['connect', 'understand', 'reflect', 'discuss', 'agree', 'family', 'reflect_again', 'decision', 'complete'];",
                  "const stage = pm.collectionVariables.get('journeyStage');",
                  "if (!enabled || !pm.collectionVariables.get('ssActiveConnectionId') || !pm.collectionVariables.get('questionId') || !stage || order.indexOf(stage) < order.indexOf('reflect')) {",
                  "  console.warn('Skipped reflection answer write: explicitly opt in once after Reflect is unlocked and a question ID is captured.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get reflection progress",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/connections/{{ssActiveConnectionId}}/reflect/progress"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const order = ['connect', 'understand', 'reflect', 'discuss', 'agree', 'family', 'reflect_again', 'decision', 'complete'];",
                  "const stage = pm.collectionVariables.get('journeyStage');",
                  "if (!pm.collectionVariables.get('ssActiveConnectionId') || !stage || order.indexOf(stage) < order.indexOf('reflect')) {",
                  "  console.warn('Skipped reflection progress: an active connection with Reflect unlocked is required.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat & Messaging",
      "item": [
        {
          "name": "List chats",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/chats?filter={{chatFilter}}",
            "description": "Set chatFilter to all, active, new, or muted. Listing chats may lazily create chat records for active connections."
          }
        },
        {
          "name": "List chats - invalid filter (400)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/chats?filter=invalid",
            "description": "Negative validation case."
          }
        },
        {
          "name": "List messages",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/chats/{{chatId}}/messages?cursor={{messageCursor}}",
            "description": "First invocation omits cursor and fetches newest messages; subsequent invocations use the captured nextCursor. Set messagePageStarted=false to restart from newest."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "if (!pm.collectionVariables.get('chatId')) {",
                  "  console.warn('Skipped message history: run List chats and ensure a chat exists.');",
                  "  pm.execution.skipRequest();",
                  "}",
                  "if (pm.collectionVariables.get('messagePageStarted') === 'true' && pm.collectionVariables.get('messageHasMore') !== 'true') {",
                  "  console.warn('Skipped message history: no older page remains; reset messagePageStarted=false to fetch newest again.');",
                  "  pm.execution.skipRequest();",
                  "}",
                  "if (!pm.collectionVariables.get('messageCursor')) pm.request.url.query.remove('cursor');"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"text\":\"Hello, it is nice to connect.\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/chats/{{chatId}}/messages",
            "description": "Sends a message and changes data. Set sendMessage=true for one manually chosen send."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('sendMessage') === 'true';",
                  "pm.collectionVariables.set('sendMessage', 'false');",
                  "if (!enabled || !pm.collectionVariables.get('chatId')) {",
                  "  console.warn('Skipped message send: set sendMessage=true once and run List chats to capture a valid chat ID.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark received messages as read",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/chats/{{chatId}}/read",
            "description": "Updates read status for messages in this chat. Set markMessagesRead=true for one manually chosen read update."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('markMessagesRead') === 'true';",
                  "pm.collectionVariables.set('markMessagesRead', 'false');",
                  "if (!enabled || !pm.collectionVariables.get('chatId')) {",
                  "  console.warn('Skipped read-status update: set markMessagesRead=true once and ensure a chat ID is captured.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Set chat mute preference",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{requestSenderToken}}", "type": "string" }] },
            "header": [],
            "body": { "mode": "raw", "raw": "{\"muted\":true}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/chats/{{chatId}}/mute",
            "description": "Changes this user's chat preference. Set setChatMuted=true for one manually chosen mute update."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const enabled = pm.collectionVariables.get('setChatMuted') === 'true';",
                  "pm.collectionVariables.set('setChatMuted', 'false');",
                  "if (!enabled || !pm.collectionVariables.get('chatId')) {",
                  "  console.warn('Skipped mute preference update: set setChatMuted=true once and ensure a chat ID is captured.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get preference section",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
            "url": "{{baseUrl}}/me/preferences/{{preferenceSection}}",
            "description": "preferenceSection must be basic, lifestyle, family, valuesOutlook, or additional."
          }
        },
        {
          "name": "Update preference section",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{aanyaToken}}", "type": "string" }] },
            "header": [],
