  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text",
        "exec": [
          "const rules = {",
          "  'Dev login - Aanya': [200, ['data.token', 'data.user.id']],",
          "  'Dev login - Rohan': [200, ['data.token', 'data.user.id']],",
          "  'Dev login - Karthik': [200, ['data.token', 'data.user.id']],",
          "  'Get current user': [200, ['data.user.id']],",
          "  'Get my profile': [200, ['data.profile.id']],",
          "  'Update my profile': [200, ['data.profile.id']],",
          "  'Get profile by user ID': [200, ['data.profile.id']],",
          "  'Discover profiles': [200, ['data.users']],",
          "  'List requests': [200, ['data.requests']],",
          "  'List requests - invalid box (400)': [400, []],",
          "  'Send connection request': [201, ['data.request.id']],",
          "  'Accept connection request': [200, ['data.request.id', 'data.connection.id']],",
          "  'Decline connection request': [200, ['data.request.id']],",
          "  'Withdraw connection request': [200, ['data.request.id']],",
          "  'List active connections': [200, ['data.connections']],",
          "  'Get connection': [200, ['data.connection.id']],",
          "  'Get home': [200, ['data.greeting', 'data.profileComplete', 'data.needsYourAttention', 'data.unreadNotifications']],",
          "  'List notifications': [200, ['data.notifications']],",
          "  'Mark notification as read': [200, ['data.notification.id']],",
          "  'Get connection journey': [200, ['data.journey.connectionId', 'data.journey.stages']],",
          "  'Get stage content': [200, ['data.stageContent.stage', 'data.stageContent.guidance', 'data.stageContent.forYou', 'data.stageContent.activities', 'data.stageContent.resources', 'data.stageContent.isMock']],",
          "  'Complete active stage': [200, ['data.completedStage', 'data.journey']],",
          "  'Get reflection questions': [200, ['data.questions']],",
          "  'Save reflection answer': [200, ['data.answer.id']],",
          "  'Get reflection progress': [200, ['data.progress.answeredCount', 'data.progress.totalQuestions', 'data.progress.complete', 'data.progress.answers']],",
          "  'List chats': [200, ['data.chats']],",
          "  'List chats - invalid filter (400)': [400, []],",
          "  'List messages': [200, ['data.messages', 'data.nextCursor']],",
          "  'Send message': [201, ['data.message.id', 'data.message.senderId', 'data.message.text', 'data.message.createdAt', 'data.message.isReadByMe']],",
          "  'Mark received messages as read': [200, ['data.markedRead']],",
          "  'Set chat mute preference': [200, ['data.chatId', 'data.muted']],",
          "  'Get preference section': [200, ['data.section', 'data.preferences']],",
          "  'Update preference section': [200, ['data.section', 'data.preferences']],",
          "  'Update sharing default': [200, ['data.sharingDefault']],",
          "  'Liveness': [200, ['data.status']],",
          "  'Readiness': [200, ['data.status'], [503]]",
          "};",
          "const name = pm.info.requestName;",
          "const rule = rules[name];",
          "pm.test('Expected HTTP status', function () {",
          "  pm.expect(rule, 'A response rule must exist for this request').to.exist;",
          "  const statusMessage = name === 'Send connection request' && pm.response.code === 409",
          "    ? '409 Conflict: no request was created because a pending request or active connection already exists. Run List requests to recover a pending request ID, or List active connections to recover the connection ID.'",
          "    : 'Unexpected HTTP status';",
          "  pm.expect([rule[0]].concat(rule[2] || []), statusMessage).to.include(pm.response.code);",
          "});",
          "let body;",
          "pm.test('Response is valid JSON', function () {",
          "  body = pm.response.json();",
          "  pm.expect(body).to.be.an('object');",
          "});",
          "if (rule && body) {",
          "  if (pm.response.code >= 400) {",
          "    pm.test('Error response follows the documented contract', function () {",
          "      pm.expect(body.error).to.be.an('object');",
          "      pm.expect(body.error.code).to.be.a('string').and.not.empty;",
          "      pm.expect(body.error.message).to.be.a('string').and.not.empty;",
          "      pm.expect(body.error.details).to.be.an('array');",
          "    });",
          "  } else {",
          "    pm.test('Success response has documented properties', function () {",
          "      pm.expect(body.data).to.be.an('object');",
          "      rule[1].forEach(function (path) {",
          "        const value = path.split('.').reduce(function (current, key) { return current == null ? undefined : current[key]; }, body);",
          "        pm.expect(value, path).not.to.be.undefined;",
          "      });",
          "    });",
          "  }",
          "  if (pm.response.code < 400 && name.indexOf('Dev login - ') === 0) {",
          "    const user = name.substring('Dev login - '.length).toLowerCase();",
          "    pm.collectionVariables.set(user + 'Token', body.data.token);",
          "    pm.collectionVariables.set(user + 'UserId', body.data.user.id);",
          "    if (user === 'aanya') {",
          "      pm.collectionVariables.set('requestSenderToken', body.data.token);",
          "      pm.collectionVariables.set('requestSenderId', body.data.user.id);",
          "    }",
          "    if (user === 'rohan') {",
          "      pm.collectionVariables.set('requestRecipientToken', body.data.token);",
          "      pm.collectionVariables.set('requestRecipientId', body.data.user.id);",
          "    }",
          "  }",
          "  if (pm.response.code < 400 && name === 'List requests') {",
          "    const senderId = pm.collectionVariables.get('requestSenderId');",
          "    const recipientId = pm.collectionVariables.get('requestRecipientId');",
          "    const pending = Array.isArray(body.data.requests) ? body.data.requests.find(function (item) {",
          "      return item.sender && item.recipient && item.sender.id === senderId && item.recipient.id === recipientId;",
          "    }) : undefined;",
          "    const id = pending && pending.id ? pending.id : '';",
          "    pm.collectionVariables.set('ssRequestId', id);",
          "    if (id) pm.collectionVariables.set('ssLastRequestId', id);",
          "  }",
          "  if (pm.response.code === 201 && name === 'Send connection request' && body.data.request && body.data.request.id) {",
          "    pm.collectionVariables.set('ssRequestId', body.data.request.id);",
          "    pm.collectionVariables.set('ssLastRequestId', body.data.request.id);",
          "  }",
          "  if (name === 'Send connection request' && pm.response.code === 409) {",
          "    pm.collectionVariables.set('ssRequestId', '');",
          "    console.warn('409 Conflict is not a successful create. No request ID was captured; use List requests or List active connections to recover existing state.');",
          "  }",
          "  if (pm.response.code < 400 && name === 'Accept connection request' && body.data.request && body.data.request.id) {",
          "    pm.collectionVariables.set('ssLastRequestId', body.data.request.id);",
          "    pm.collectionVariables.set('ssRequestId', '');",
          "    pm.collectionVariables.set('requestAction', 'none');",
          "    if (body.data.connection && body.data.connection.id) pm.collectionVariables.set('ssActiveConnectionId', body.data.connection.id);",
          "  }",
          "  if (pm.response.code < 400 && (name === 'Decline connection request' || name === 'Withdraw connection request') && body.data.request && body.data.request.id) {",
          "    pm.collectionVariables.set('ssLastRequestId', body.data.request.id);",
          "    pm.collectionVariables.set('ssRequestId', '');",
          "    pm.collectionVariables.set('requestAction', 'none');",
          "  }",
          "  if (pm.response.code === 409 && ['Accept connection request', 'Decline connection request', 'Withdraw connection request'].includes(name)) {",
          "    pm.collectionVariables.set('ssRequestId', '');",
          "    console.warn('409 Conflict: this request is no longer pending. Run List requests to refresh the pending request ID.');",
          "  }",
          "  if (pm.response.code < 400 && name === 'List active connections') {",
          "    const senderId = pm.collectionVariables.get('requestSenderId');",
          "    const recipientId = pm.collectionVariables.get('requestRecipientId');",
          "    const connection = Array.isArray(body.data.connections) ? body.data.connections.find(function (item) {",
          "      const ids = (item.participants || []).map(function (participant) { return participant.user && participant.user.id; });",
          "      return ids.includes(senderId) && ids.includes(recipientId);",
          "    }) : undefined;",
          "    pm.collectionVariables.set('ssActiveConnectionId', connection && connection.id ? connection.id : '');",
          "  }",
          "  if (pm.response.code < 400 && name === 'Get connection journey' && body.data.journey) {",
          "    const journey = body.data.journey;",
          "    pm.collectionVariables.set('journeyStage', journey.currentStage || (journey.completed ? 'decision' : 'connect'));",
          "    pm.collectionVariables.set('journeyCompleted', journey.completed ? 'true' : 'false');",
          "    if (body.data.journey.connectionId) pm.collectionVariables.set('ssActiveConnectionId', body.data.journey.connectionId);",
          "  }",
          "  if (pm.response.code < 400 && name === 'Get connection' && body.data.connection && body.data.connection.id) {",
          "    pm.collectionVariables.set('ssActiveConnectionId', body.data.connection.id);",
          "  }",
          "  if (pm.response.code < 400 && name === 'List chats') {",
          "    const chats = Array.isArray(body.data.chats) ? body.data.chats : [];",
          "    const connectionId = pm.collectionVariables.get('ssActiveConnectionId');",
          "    const chat = chats.find(function (item) { return item.connectionId === connectionId; }) || chats[0];",
          "    pm.collectionVariables.set('chatId', chat && chat.id ? chat.id : '');",
          "  }",
          "  if (pm.response.code < 400 && name === 'Get reflection questions') {",
          "    const questions = Array.isArray(body.data.questions) ? body.data.questions : [];",
          "    pm.collectionVariables.set('questionId', questions.length ? (questions[0]._id || questions[0].id || '') : '');",
          "  }",
          "  if (pm.response.code < 400 && name === 'List notifications') {",
          "    const notifications = Array.isArray(body.data.notifications) ? body.data.notifications : [];",
          "    const unread = notifications.find(function (item) { return !item.readAt; });",
          "    pm.collectionVariables.set('notificationId', unread && unread.id ? unread.id : '');",
          "  }",
          "  if (pm.response.code < 400 && name === 'List messages') {",
          "    pm.collectionVariables.set('messageCursor', body.data.nextCursor || '');",
          "    pm.collectionVariables.set('messageHasMore', body.data.nextCursor ? 'true' : 'false');",
          "    pm.collectionVariables.set('messagePageStarted', 'true');",
          "  }",
          "}"
        ]
      }
    }
  ],
