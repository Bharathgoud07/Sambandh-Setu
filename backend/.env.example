PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sambandh_setu
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# OTP configuration
OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Email provider: placeholder or brevo
EMAIL_PROVIDER=placeholder
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Sambandh Setu

# Setu Guide service
GUIDE_SERVICE_URL=https://setu-guide-1wiy.onrender.com

# Comma-separated exact browser origins. Set real values in the host dashboard.
CORS_ALLOWED_ORIGINS=https://web.example.com,https://staging.example.com

# Rate limits. Leave unset to use documented defaults.
# Global: 300 requests / 15 minutes; auth: 5 / hour per IP and per email.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_IP_WINDOW_MS=3600000
RATE_LIMIT_AUTH_EMAIL_MAX=5
RATE_LIMIT_AUTH_EMAIL_WINDOW_MS=3600000

# Set true on Render so req.ip uses the proxy's client IP.
TRUST_PROXY=false

# Optional error tracking. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
