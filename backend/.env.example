PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sambandh_setu
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Comma-separated exact browser origins. Set the real values in the host
# dashboard. Native mobile apps send no Origin header and are unaffected.
CORS_ALLOWED_ORIGINS=https://web.example.com,https://staging.example.com

# Optional error tracking. Leave empty to disable (no SDK load, no network).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Setu Guide base URL. The staging/production value is set on the host, never committed.
# Used by scripts/check-guide.js today; the /guide/chat call is added in D1-16 / D2-04.
GUIDE_SERVICE_URL=https://REPLACE-WITH-GUIDE-STAGING-URL